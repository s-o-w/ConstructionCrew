<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ConstructionCrew.Core\ConstructionCrew.Core.csproj" />
    <ProjectReference Include="..\ConstructionCrew.Providers\ConstructionCrew.Providers.csproj" />
    <ProjectReference Include="..\ConstructionCrew.Graph\ConstructionCrew.Graph.csproj" />
    <ProjectReference Include="..\ConstructionCrew.HomeOffice\ConstructionCrew.HomeOffice.csproj" />
    <ProjectReference Include="..\ConstructionCrew.Config\ConstructionCrew.Config.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No native apphost .exe is produced: a freshly-built, unsigned binary that
         spawns child processes and opens a socket gets blocked by endpoint security
         on this machine on sight. Running the managed DLL through dotnet.exe (already
         trusted) instead avoids that entirely. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
